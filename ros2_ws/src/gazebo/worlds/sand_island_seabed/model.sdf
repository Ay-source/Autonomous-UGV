<?xml version="1.0"?>
<!--
  The seabed at Sand Island, Honolulu: optional, for the sand_island worlds
  (any tier). Include it for underwater vehicles, sonars and Doppler
  velocity logs, or for a hull to ground on the shallows; a world on the
  surface alone does without. GENERATED by kai_gazebo/tools
  (sites/bathymetry.py and the world's build.py and assemble.py); edit the
  tools, not this file.

  Static, in the world frame: the water at z = 0. The meshes are glTF (Y up),
  shared with the site in meshes. The collision is a coarser
  mesh of the same bed: DART collides it as it is (MuJoCo would take its
  convex hull, so leave it out there).

  Bathymetry: NOAA NCEI Continuously Updated Digital Elevation Model
  (CUDEM), 1/9 arc second, Hawaii (2021), public domain.
-->
<sdf version="1.11">
  <model name="sand_island_seabed">
    <static>true</static>
    <link name="link">
      <visual name="seabed">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><mesh><uri>meshes/seabed.gltf</uri></mesh></geometry>
        <cast_shadows>false</cast_shadows>
      </visual>
      <collision name="seabed">
        <pose>0 0 0 1.5707963 0 0</pose>
        <geometry><mesh><uri>meshes/seabed_collision.gltf</uri></mesh></geometry>
      </collision>
    </link>
  </model>
</sdf>
