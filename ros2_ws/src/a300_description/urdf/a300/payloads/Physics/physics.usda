            custom rel physics:body1
            append rel physics:body1 = </accessories/Geometry/base_link/chassis_link/chassis_left_suspension_mount/left_suspension_beam_spacer_link/left_suspension_beam_link>
            point3f physics:localPos0 = (0, 0.0159, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "right_suspension_beam_spacer_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </accessories/Geometry/base_link/chassis_link/chassis_right_suspension_mount>
            custom rel physics:body1
