            custom rel physics:body1
            append rel physics:body1 = </accessories/Geometry/base_link/chassis_link/chassis_right_suspension_mount/right_suspension_beam_spacer_link/right_suspension_beam_link/right_suspension_beam_front_mount/front_right_motor_link>
