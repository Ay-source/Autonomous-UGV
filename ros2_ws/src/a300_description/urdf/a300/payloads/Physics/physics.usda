            append rel physics:body0 = </accessories/Geometry/base_link/chassis_link/chassis_left_suspension_mount/left_suspension_beam_spacer_link/left_suspension_beam_link/left_suspension_beam_front_mount>
            custom rel physics:body1
            append rel physics:body1 = </accessories/Geometry/base_link/chassis_link/chassis_left_suspension_mount/left_suspension_beam_spacer_link/left_suspension_beam_link/left_suspension_beam_front_mount/front_left_motor_link>
            point3f physics:localPos0 = (0, 0, 0)
