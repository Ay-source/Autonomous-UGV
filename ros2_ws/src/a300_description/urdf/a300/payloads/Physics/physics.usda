#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "accessories"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "accessories"
{
    over "Geometry"
    {
        over "base_link"
        {
            over "chassis_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI", "PhysicsMassAPI", "NewtonMassAPI"]
            )
            {
                double[] newton:inertia = [1.1408911178058334, 4.621734451139166, 5.147823333333332, 0, 0, 0]
                bool newton:selfCollisionEnabled = 0
                point3f physics:centerOfMass = (0, 0, 0.1147795)
                float3 physics:diagonalInertia = (1.1408911, 4.6217346, 5.1478233)
                float physics:mass = 70
                quatf physics:principalAxes = (1, 0, 0, 0)

                over "chassis_left_suspension_mount"
                {
                    over "left_suspension_beam_spacer_link" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
                    )
                    {
                        over "left_suspension_beam_link" (
                            prepend apiSchemas = ["PhysicsRigidBodyAPI"]
                        )
                        {
                            over "left_suspension_beam_front_mount"
                            {
                                over "front_left_motor_link" (
                                    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
                                )
                                {
                                    over "front_left_motor_mount"
                                    {
                                        over "front_left_wheel_link" (
                                            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                                        )
                                        {
                                            double[] newton:inertia = [0.019758025, 0.0340725125, 0.019758025, 0, 0, 0]
                                            point3f physics:centerOfMass = (0, 0, 0)
                                            float3 physics:diagonalInertia = (0.019758025, 0.019758025, 0.03407251)
                                            float physics:mass = 2.5
                                            quatf physics:principalAxes = (-0.70710677, 0.70710677, 0, 0)

                                            over "cylinder" (
                                                prepend apiSchemas = ["NewtonCollisionAPI"]
                                            )
                                            {
                                            }
                                        }
                                    }
                                }
                            }

                            over "left_suspension_beam_rear_mount"
                            {
                                over "rear_left_motor_link" (
                                    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
                                )
                                {
                                    over "rear_left_motor_mount"
                                    {
                                        over "rear_left_wheel_link" (
                                            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                                        )
                                        {
                                            double[] newton:inertia = [0.019758025, 0.0340725125, 0.019758025, 0, 0, 0]
                                            point3f physics:centerOfMass = (0, 0, 0)
                                            float3 physics:diagonalInertia = (0.019758025, 0.019758025, 0.03407251)
                                            float physics:mass = 2.5
                                            quatf physics:principalAxes = (-0.70710677, 0.70710677, 0, 0)

                                            over "cylinder" (
                                                prepend apiSchemas = ["NewtonCollisionAPI"]
                                            )
                                            {
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                over "chassis_right_suspension_mount"
                {
                    over "right_suspension_beam_spacer_link" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
                    )
                    {
                        over "right_suspension_beam_link" (
                            prepend apiSchemas = ["PhysicsRigidBodyAPI"]
                        )
                        {
                            over "right_suspension_beam_front_mount"
                            {
                                over "front_right_motor_link" (
                                    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
                                )
                                {
                                    over "front_right_motor_mount"
                                    {
                                        over "front_right_wheel_link" (
                                            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                                        )
                                        {
                                            double[] newton:inertia = [0.019758025, 0.0340725125, 0.019758025, 0, 0, 0]
                                            point3f physics:centerOfMass = (0, 0, 0)
                                            float3 physics:diagonalInertia = (0.019758025, 0.019758025, 0.03407251)
                                            float physics:mass = 2.5
                                            quatf physics:principalAxes = (-0.70710677, 0.70710677, 0, 0)

                                            over "cylinder" (
                                                prepend apiSchemas = ["NewtonCollisionAPI"]
                                            )
                                            {
                                            }
                                        }
                                    }
                                }
                            }

                            over "right_suspension_beam_rear_mount"
                            {
                                over "rear_right_motor_link" (
                                    prepend apiSchemas = ["PhysicsRigidBodyAPI"]
                                )
                                {
                                    over "rear_right_motor_mount"
                                    {
                                        over "rear_right_wheel_link" (
                                            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
                                        )
                                        {
                                            double[] newton:inertia = [0.019758025, 0.0340725125, 0.019758025, 0, 0, 0]
                                            point3f physics:centerOfMass = (0, 0, 0)
                                            float3 physics:diagonalInertia = (0.019758025, 0.019758025, 0.03407251)
                                            float physics:mass = 2.5
                                            quatf physics:principalAxes = (-0.70710677, 0.70710677, 0, 0)

                                            over "cylinder" (
                                                prepend apiSchemas = ["NewtonCollisionAPI"]
                                            )
                                            {
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                over "default_mount"
                {
                    over "top_plate_link" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI"]
                    )
                    {
                        over "box" (
                            prepend apiSchemas = ["NewtonCollisionAPI"]
                        )
                        {
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        def PhysicsRevoluteJoint "front_left_wheel_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            uniform token physics:axis = "Y"
            custom rel physics:body0
            append rel physics:body0 = </accessories/Geometry/base_link/chassis_link/chassis_left_suspension_mount/left_suspension_beam_spacer_link/left_suspension_beam_link/left_suspension_beam_front_mount/front_left_motor_link/front_left_motor_mount>
            custom rel physics:body1
            append rel physics:body1 = </accessories/Geometry/base_link/chassis_link/chassis_left_suspension_mount/left_suspension_beam_spacer_link/left_suspension_beam_link/left_suspension_beam_front_mount/front_left_motor_link/front_left_motor_mount/front_left_wheel_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsRevoluteJoint "front_right_wheel_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            uniform token physics:axis = "Y"
            custom rel physics:body0
