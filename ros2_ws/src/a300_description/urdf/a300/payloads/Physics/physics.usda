            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsRevoluteJoint "rear_right_wheel_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            uniform token physics:axis = "Y"
            custom rel physics:body0
            append rel physics:body0 = </accessories/Geometry/base_link/chassis_link/chassis_right_suspension_mount/right_suspension_beam_spacer_link/right_suspension_beam_link/right_suspension_beam_rear_mount/rear_right_motor_link/rear_right_motor_mount>
            custom rel physics:body1
            append rel physics:body1 = </accessories/Geometry/base_link/chassis_link/chassis_right_suspension_mount/right_suspension_beam_spacer_link/right_suspension_beam_link/right_suspension_beam_rear_mount/rear_right_motor_link/rear_right_motor_mount/rear_right_wheel_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "top_plate_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </accessories/Geometry/base_link/chassis_link/default_mount>
            custom rel physics:body1
            append rel physics:body1 = </accessories/Geometry/base_link/chassis_link/default_mount/top_plate_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "chassis_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </accessories>
            custom rel physics:body1
            append rel physics:body1 = </accessories/Geometry/base_link/chassis_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "left_suspension_beam_spacer_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </accessories/Geometry/base_link/chassis_link/chassis_left_suspension_mount>
            custom rel physics:body1
            append rel physics:body1 = </accessories/Geometry/base_link/chassis_link/chassis_left_suspension_mount/left_suspension_beam_spacer_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
