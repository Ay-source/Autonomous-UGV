            custom rel physics:body1
            append rel physics:body1 = </accessories/Geometry/base_link/chassis_link/chassis_right_suspension_mount/right_suspension_beam_spacer_link/right_suspension_beam_link/right_suspension_beam_front_mount/front_right_motor_link/front_right_motor_mount/front_right_wheel_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsRevoluteJoint "rear_left_wheel_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
